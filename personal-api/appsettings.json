{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Default": "Data Source=data/personal-api.db"
  },
  "Cache": {
    "Enabled": true,
    "TtlSeconds": 30,
    "MaxEntries": 512
  },
  "Warmup": {
    "Enabled": true,
    "RefreshAhead": true,
    "Connections": 8,
    "OverviewDays": "7,30,90,365"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
